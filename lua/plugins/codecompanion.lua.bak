return {
  "olimorris/codecompanion.nvim",
  dependencies = {
    "nvim-lua/plenary.nvim",
    "nvim-treesitter/nvim-treesitter",
  },
  opts = {
    -- Adapter configuration (updated to new format)
    adapters = {
      http = {
        anthropic = function()
          return require("codecompanion.adapters").extend("anthropic", {
            env = {
              api_key = "ANTHROPIC_API_KEY", -- Will read from environment variable
            },
        schema = {
          model = {
            default = "claude-3-5-sonnet-20241022", -- or claude-3-haiku-20240307 for cheaper
          },

          })
        end,
      },
    },
    strategies = {
      -- Use Anthropic for chat by default
      chat = {
        adapter = "anthropic",
      },
      inline = {
        adapter = "anthropic",
      },
      agent = {
        adapter = "anthropic",
      },
    },
  },
  keys = {
    -- Toggle chat
    { "<leader>cc", "<cmd>CodeCompanionChat Toggle<cr>", mode = { "n", "v" }, desc = "Toggle CodeCompanion Chat" },

    -- Action palette
    { "<leader>ca", "<cmd>CodeCompanionActions<cr>", mode = { "n", "v" }, desc = "CodeCompanion Actions" },

    -- Add visual selection to chat
    { "ga", "<cmd>CodeCompanionChat Add<cr>", mode = "v", desc = "Add to CodeCompanion Chat" },
  },
  config = function(_, opts)
    require("codecompanion").setup(opts)

    -- Add command abbreviation for quick access
    vim.cmd([[cab cc CodeCompanion]])
  end,
}
